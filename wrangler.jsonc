{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neotypelab-terminal",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "neotypelab.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
