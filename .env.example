VITE_SITE_URL=https://neotypelab.com

VITE_CONVEX_URL=https://resolute-giraffe-272.convex.cloud
VITE_CONVEX_SITE_URL=https://resolute-giraffe-272.convex.site
CONVEX_DEPLOYMENT=prod:your-deployment

VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key
CLERK_SECRET_KEY=sk_live_your_secret_key
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

SUPER_ADMIN_EMAILS=admin@example.com

R2_BUCKET_PUBLIC=neotypelab-prod-showcase
R2_BUCKET_PRIVATE=neotypelab-prod-library
R2_PUBLIC_BASE_URL=https://assets.neotypelab.example
# Reserved for a future authenticated delivery Worker. Private object access uses signed S3 URLs.
R2_PRIVATE_BASE_URL=https://library.neotypelab.example
R2_END_POINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_TOKEN=your_r2_api_token
ACCOUNT_ID=your_cloudflare_account_id
# Optional but required to purge cached Showcase assets immediately on withdrawal.
CLOUDFLARE_CACHE_PURGE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_CACHE_PURGE_TOKEN=your_cache_purge_api_token

# Shared secret used to authenticate normalized subscription events sent to /billing/webhook.
BILLING_WEBHOOK_SECRET=replace_with_at_least_32_random_bytes

OPENAI_API_KEY=sk-your_openai_key
OPENAI_IMAGE_MODEL=gpt-image-1
