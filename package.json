    "react-day-picker": "^8.9.1",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.47.0",
    "react-remove-scroll": "^2.5.6",
    "resend": "^2.1.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "3.3.3",
