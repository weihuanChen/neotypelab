{
  "name": "neotypelab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:full",
    "dev:full": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite dev",
    "dev:backend": "convex dev --typecheck=disable",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:tanstack-boundary": "node scripts/checkTanStackBoundary.mjs",
    "lint:eslint": "eslint src convex lib components scripts --ext .js,.cjs,.ts,.tsx",
    "lint": "npm-run-all --serial typecheck check:tanstack-boundary lint:eslint",
    "test": "npm run test:integration",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public",
    "import:paint-catalog": "tsx scripts/importPaintCatalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
