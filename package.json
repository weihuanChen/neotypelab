    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0-canary-7118f5dd7-20230705",
    "npm-run-all": "^4.1.5",
